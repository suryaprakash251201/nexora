{
  "name": "Nexora — Your private file workspace",
  "short_name": "Nexora",
  "description": "Self-hosted file workspace: files, photos, music and sharing on your own server.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090B12",
