{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "upload:default",
    "process:default",
    "updater:default",
    "notification:default",
    "global-shortcut:default",
    "autostart:default",
    "window-state:default",
    {
      "identifier": "shell:allow-open",
      "description": "Open links and local folders/files in their default handler. Explicitly allows web/mail links and absolute filesystem paths (needed by 'reveal in file manager'); every other target stays blocked.",
      "allow": [
        { "url": "^mailto:" },
        { "url": "^tel:" },
        { "url": "^https?://" },
        { "url": "^file:///" },
        { "url": "^/" },
        { "url": "^[A-Za-z]:[\\\\/]" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    }
  ]
}
