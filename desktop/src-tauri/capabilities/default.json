{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "upload:default",
    "process:default",
    "updater:default",
    "notification:default",
    "global-shortcut:default",
    "autostart:default",
    "window-state:default",
    "shell:allow-open",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "description": "Allow opening files in VLC as an external player (invoked via the frontend's 'Open in native player' action). Scoped to the well-known VLC install locations on each OS; all other executables remain blocked.",
      "allow": [
        {
          "name": "vlc",
          "cmd": "vlc",
          "args": true
        },
        {
          "name": "vlc-win64",
          "cmd": "C:\\Program Files\\VideoLAN\\VLC\\vlc.exe",
          "args": true
        },
        {
          "name": "vlc-win32",
          "cmd": "C:\\Program Files (x86)\\VideoLAN\\VLC\\vlc.exe",
          "args": true
        },
        {
          "name": "vlc-macos",
          "cmd": "/Applications/VLC.app/Contents/MacOS/VLC",
          "args": true
        }
      ]
    }
  ]
}
