# Caddy reverse proxy for Nexora HTTPS
# Self-signed cert (internal/tailnet use). Browser will show a warning —
# click Advanced → Accept the Risk.
#
# To switch to proper Let's Encrypt certs (requires a public domain):
#   1. Change to: tls you@example.com
#   2. Point your domain's A record to the Tailscale IP
#   3. Restart caddy

pms2.tail58d7ea.ts.net {
    tls internal
    reverse_proxy nexora:80
}

# Redirect HTTP → HTTPS
pms2.tail58d7ea.ts.net:80 {
    redir https://pms2.tail58d7ea.ts.net{uri} permanent
}
